class_name ChunkData
extends RefCounted

## EVERYTHING a chunk is, with no scene tree attached: heights, biomes,
## tint colours, normals, seeds, scatter entries. Generated by a pure
## function of (coordinate, terrain, config) — same inputs, same data,
## forever. Nodes are built FROM this and can be freed without losing
## the world. The shape is Chapter 4's SeedNode, grown: an address
## ("terrain/x,z"), a stored seed pair, cheap create(), expensive
## process(), and regeneration standing in for unload().
## (Chapter 13, Listings 13.3 + 13.4; LOD stride view: Chapter 14,
## Listing 14.3.)

var coord: Vector2i = Vector2i.ZERO
var heights: PackedFloat32Array = PackedFloat32Array()  # (cells+1)^2
var biomes: PackedByteArray = PackedByteArray()         # (cells+1)^2
var colors: PackedColorArray = PackedColorArray()       # (cells+1)^2
var normals: PackedVector3Array = PackedVector3Array()  # (cells+1)^2
var scatter_seed: int = 0
var detail_strength: float = 1.0                        # rolled by create()
var stored_seed_a: int = 0   # the SeedNode pair, at production scale:
var stored_seed_b: int = 0   # later systems roll from these, not coords
var scatter: Array[Dictionary] = []                     # filled by Part III

## The LOD stride for this data AS BUILT (a build-time property the
## manager stamps; the stored grids are always full resolution).
var lod_step: int = 1

## create(): the CHEAP half. Roll this chunk's parameters — detail
## strength, scatter seed, stored pair — and stop. No grids, no
## sampling: a created-but-unprocessed chunk is a promise that costs
## a few bytes, which is how distant content exists as parameters only.
## ROLL ORDER IS APPEND-ONLY (see Section 13.2): never insert a roll.
static func create(p_coord: Vector2i, cfg: WorldConfig) -> ChunkData:
	var data := ChunkData.new()
	data.coord = p_coord
	var rng: RandomNumberGenerator = SeedBank.stream_for_chunk(
			cfg.master_seed, "terrain", p_coord)
	data.detail_strength = rng.randf_range(0.7, 1.3)  # roll 1
	data.scatter_seed = rng.randi()                   # roll 2
	data.stored_seed_a = rng.randi()                  # roll 3 (SeedNode pair)
	data.stored_seed_b = rng.randi()                  # roll 4
	return data

## A private stream for one later purpose, seeded from the STORED pair
## rather than from the coordinates (SeedNode.own_stream()'s shape):
## same stored pair, same dice, even if the coordinate-hashing scheme
## ever changes underneath it.
func stream_from_stored(stream_name: String) -> RandomNumberGenerator:
	var rng := RandomNumberGenerator.new()
	rng.seed = hash(str(stored_seed_a) + ":" + str(stored_seed_b) + ":" + stream_name)
	return rng

## generate(): create + process in one call, for callers that want the
## whole chunk now. process() itself is Listing 13.4 (apron + normals).
static func generate(p_coord: Vector2i, terrain: TerrainHeight, cfg: WorldConfig) -> ChunkData:
	var data: ChunkData = ChunkData.create(p_coord, cfg)
	data.process(terrain, cfg)
	return data

## One integer that stands for this chunk's landscape. Regression
## tests, save verification and bug reports all speak in hashes.
func data_hash() -> int:
	return hash(heights)

## process(): the EXPENSIVE half. Expand the rolled parameters into
## full grids, sampling a one-cell APRON of neighbour heights so the
## normals at the border know the slope on BOTH sides (Section 13.4).
func process(terrain: TerrainHeight, cfg: WorldConfig) -> void:
	var cells: int = cfg.chunk_cells
	var cell: float = cfg.cell_size_m()
	var origin: Vector2 = Vector2(float(coord.x), float(coord.y)) * cfg.chunk_size_m
	var side: int = cells + 1
	heights.resize(side * side)
	biomes.resize(side * side)
	colors.resize(side * side)
	normals.resize(side * side)
	# The apron: an extra ring of heights around the chunk, same spacing.
	# apron[(gz+1) * (side+2) + (gx+1)] lines up with heights[gz*side+gx].
	var apron := PackedFloat32Array()
	var apron_side: int = side + 2
	apron.resize(apron_side * apron_side)
	for az in range(apron_side):
		for ax in range(apron_side):
			var wx: float = origin.x + float(ax - 1) * cell
			var wz: float = origin.y + float(az - 1) * cell
			apron[az * apron_side + ax] = _chunk_height(
					terrain, wx, wz, ax - 1, az - 1, cells)
	for gz in range(side):
		for gx in range(side):
			var wx: float = origin.x + float(gx) * cell
			var wz: float = origin.y + float(gz) * cell
			var idx: int = gz * side + gx
			heights[idx] = apron[(gz + 1) * apron_side + (gx + 1)]
			var biome: int = terrain.biome_at_world(wx, wz) if not terrain.noise_backed else 1
			biomes[idx] = biome
			colors[idx] = _tint_for(biome, heights[idx], terrain)
			# Analytic normal from central differences across the apron.
			var hl: float = apron[(gz + 1) * apron_side + gx]
			var hr: float = apron[(gz + 1) * apron_side + (gx + 2)]
			var hu: float = apron[gz * apron_side + (gx + 1)]
			var hd: float = apron[(gz + 2) * apron_side + (gx + 1)]
			normals[idx] = Vector3(hl - hr, 2.0 * cell, hu - hd).normalized()

## The shared height value (field + windowed detail) used for BOTH the
## mesh grid and the apron — one function, so the two can never disagree.
func _chunk_height(terrain: TerrainHeight, wx: float, wz: float,
		gx: int, gz: int, cells: int) -> float:
	var h: float = terrain.height_at(wx, wz)
	var u: float = clampf(float(gx) / float(cells), 0.0, 1.0)
	var v: float = clampf(float(gz) / float(cells), 0.0, 1.0)
	var window: float = clampf(sin(u * PI) * sin(v * PI) * 1.6, 0.0, 1.0)
	return h + terrain.detail_at(wx, wz) * detail_strength * window

func _tint_for(biome: int, h: float, terrain: TerrainHeight) -> Color:
	# Endless mode has no classified grid yet (Part III/IX refine this);
	# a height-based tint keeps the chunk view readable meanwhile.
	if h < terrain.sea_level:
		return Color(0.55, 0.62, 0.68)
	if h < terrain.sea_level + 1.2:
		return Color(0.76, 0.70, 0.47)
	return Color(0.35, 0.55, 0.25).lerp(Color(0.92, 0.93, 0.95),
			clampf((h - 24.0) / 20.0, 0.0, 1.0))

## Heights at an LOD stride: a strided VIEW of the full-resolution
## grid (step 1 = 33x33, 2 = 17x17, 4 = 9x9 at 32 cells). The coarse
## vertices are a strict subset of the fine ones — same values, fewer
## of them — which is what makes LOD borders agree at shared vertices.
func heights_for_lod(step: int) -> PackedFloat32Array:
	if step <= 1:
		return heights
	var side: int = int(sqrt(float(heights.size())))
	var out_side: int = (side - 1) / step + 1
	var out := PackedFloat32Array()
	out.resize(out_side * out_side)
	for gz in range(out_side):
		for gx in range(out_side):
			out[gz * out_side + gx] = heights[(gz * step) * side + (gx * step)]
	return out

## The normals twin of heights_for_lod() (Chapter 14, §14.3): without
## it the builder's size check quietly substitutes up-normals and
## distant chunks render flat-lit.
func normals_for_lod(step: int) -> PackedVector3Array:
	if step <= 1:
		return normals
	var side: int = int(sqrt(float(normals.size())))
	var out_side: int = (side - 1) / step + 1
	var out := PackedVector3Array()
	out.resize(out_side * out_side)
	for gz in range(out_side):
		for gx in range(out_side):
			out[gz * out_side + gx] = normals[(gz * step) * side + (gx * step)]
	return out
